#!/usr/bin/with-contenv bash

set -euo pipefail

# nginx Path
NGINX_CONFIG=/etc/nginx/sites-available/default

# user passed env vars
CPORT="${CUSTOM_PORT:-3000}"
CHPORT="${CUSTOM_HTTPS_PORT:-3001}"
CWS="${CUSTOM_WS_PORT:-8082}"
CLINK="${LOCAL_LINK_BRIDGE_PORT:-38080}"
CNOTIFY="${NOTIFICATION_BRIDGE_PORT:-38081}"
CAUTH="${SELKIES_SESSION_AUTH_PORT:-38082}"
SFOLDER="${SUBFOLDER:-/}"
FILE_MANAGER_PATH="${FILE_MANAGER_PATH:-$HOME/Desktop}"
DASHBOARD="${DASHBOARD:-selkies-dashboard}"
SELKIES_FILE_TRANSFERS="${SELKIES_FILE_TRANSFERS:-upload,download}"
HARDEN_DESKTOP="${HARDEN_DESKTOP:-false}"

normalize_subfolder() {
  local folder="$1"
  if [ -z "$folder" ]; then
    echo "/"
    return
  fi
  if [[ "$folder" != /* ]]; then
    folder="/$folder"
  fi
  if [[ "$folder" != */ ]]; then
    folder="$folder/"
  fi
  echo "$folder"
}

escape_sed_replacement() {
  printf '%s' "$1" | sed -e 's/[\/&]/\\&/g'
}

escape_nginx_double_quoted() {
  printf '%s' "$1" | sed -e 's/[\\"]/\\&/g' -e 's/\$/\\$/g'
}

prepare_config_logs() {
  local log_dir="/config/logs"
  install -d -o abc -g abc -m 775 "$log_dir"
  find "$log_dir" -maxdepth 1 -type f -name "*.log" -exec chown abc:abc {} + -exec chmod u+rw,g+rw {} + 2>/dev/null || true
}

prepare_config_logs

SFOLDER="$(normalize_subfolder "$SFOLDER")"
PW_PREFIX="$SFOLDER"
PW_COOKIE_PATH="$SFOLDER"
PW_ENABLED="0"
PW_TOKEN="disabled"
PW_PASSWORD_ESCAPED=""
if [ -n "${PASSWORD:-}" ]; then
  PW_ENABLED="1"
  PW_TOKEN="$(printf '%s' "${PASSWORD}" | sha256sum | awk '{print $1}')"
  PW_PASSWORD_ESCAPED="$(escape_nginx_double_quoted "${PASSWORD}")"
fi

# create self signed cert
if [ ! -f "/config/ssl/cert.pem" ]; then
  mkdir -p /config/ssl
  openssl req -new -x509 \
    -days 3650 -nodes \
    -out /config/ssl/cert.pem \
    -keyout /config/ssl/cert.key \
    -subj "/C=US/ST=CA/L=Carlsbad/O=Linuxserver.io/OU=LSIO Server/CN=*"
  chmod 600 /config/ssl/cert.key
  chown -R abc:abc /config/ssl
fi

# modify nginx config
cp /defaults/default.conf "${NGINX_CONFIG}"
sed -i "s/3000/$CPORT/g" "${NGINX_CONFIG}"
sed -i "s/3001/$CHPORT/g" "${NGINX_CONFIG}"
sed -i "s/CWS/$CWS/g" "${NGINX_CONFIG}"
sed -i "s/CLINK/$CLINK/g" "${NGINX_CONFIG}"
sed -i "s/CNOTIFY/$CNOTIFY/g" "${NGINX_CONFIG}"
sed -i "s/CAUTH/$CAUTH/g" "${NGINX_CONFIG}"
sed -i "s|SUBFOLDER|$SFOLDER|g" "${NGINX_CONFIG}"
sed -i "s|REPLACE_DOWNLOADS_PATH|$FILE_MANAGER_PATH|g" "${NGINX_CONFIG}"
s6-setuidgid abc mkdir -p "${FILE_MANAGER_PATH}"
if [[ $SELKIES_FILE_TRANSFERS != *"download"* ]] || [[ ${HARDEN_DESKTOP,,} == "true" ]]; then
  sed -i '/files {/,/^  }/d' "${NGINX_CONFIG}"
fi
if [ -n "${DISABLE_IPV6+x}" ]; then
  sed -i '/listen \[::\]/d' "${NGINX_CONFIG}"
fi
if [ -n "${DEV_MODE+x}" ]; then
  sed -i \
    -e 's:location / {:location /null {:g' \
    -e 's:location /devmode:location /:g' \
    "${NGINX_CONFIG}"
fi

sed -i "s/PW_ENABLED/${PW_ENABLED}/g" "${NGINX_CONFIG}"
sed -i "s/PW_TOKEN/$(escape_sed_replacement "$PW_TOKEN")/g" "${NGINX_CONFIG}"
sed -i "s|PW_PREFIX|$(escape_sed_replacement "$PW_PREFIX")|g" "${NGINX_CONFIG}"
sed -i "s|PW_COOKIE_PATH|$(escape_sed_replacement "$PW_COOKIE_PATH")|g" "${NGINX_CONFIG}"
sed -i "s/PW_PASSWORD/$(escape_sed_replacement "$PW_PASSWORD_ESCAPED")/g" "${NGINX_CONFIG}"

start_session_auth_bridge() {
  if pgrep -f "/scripts/session_auth_bridge.py" >/dev/null 2>&1; then
    return
  fi
  SESSION_AUTH_LOG_PATH="${SELKIES_SESSION_AUTH_LOG_PATH:-/config/logs/session-auth-bridge.log}"
  install -d -o abc -g abc -m 775 "$(dirname "$SESSION_AUTH_LOG_PATH")"
  export SELKIES_SESSION_COOKIE_PATH="$PW_COOKIE_PATH"
  nohup python3 -u /scripts/session_auth_bridge.py >>"$SESSION_AUTH_LOG_PATH" 2>&1 &
}

start_session_auth_bridge

cat > /usr/share/selkies/www/password-login.html <<EOF
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>${TITLE:-Selkies} - PIN</title>
  <style>
    :root {
      color-scheme: dark;
      --bg-a: #09111f;
      --bg-b: #132238;
      --card: rgba(8, 15, 28, 0.84);
      --card-border: rgba(148, 163, 184, 0.18);
      --text: #e5eefb;
      --muted: #9fb3cc;
      --accent: #38bdf8;
      --accent-2: #2563eb;
      --danger: #fda4af;
      --input: rgba(15, 23, 42, 0.82);
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      min-height: 100vh;
      display: grid;
      place-items: center;
      overflow: hidden;
      font-family: "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
      background:
        radial-gradient(circle at 18% 18%, rgba(56, 189, 248, 0.18), transparent 30%),
        radial-gradient(circle at 82% 10%, rgba(59, 130, 246, 0.16), transparent 28%),
        linear-gradient(160deg, var(--bg-b), var(--bg-a) 62%);
      color: var(--text);
    }
    body::before,
    body::after {
      content: "";
      position: fixed;
      pointer-events: none;
      filter: blur(10px);
      opacity: .55;
    }
    body::before {
      width: 260px;
      height: 260px;
      left: -70px;
      bottom: -70px;
      background: radial-gradient(circle, rgba(59,130,246,.35), transparent 68%);
    }
    body::after {
      width: 320px;
      height: 320px;
      right: -110px;
      top: -110px;
      background: radial-gradient(circle, rgba(14,165,233,.28), transparent 70%);
    }
    .card {
      position: relative;
      width: min(92vw, 400px);
      padding: 28px 26px 24px;
      border-radius: 22px;
      background: var(--card);
      box-shadow: 0 28px 80px rgba(2, 6, 23, 0.48);
      border: 1px solid var(--card-border);
      backdrop-filter: blur(18px);
      animation: pinCardIn .32s ease;
    }
    .brand {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 14px;
      padding: 6px 10px;
      border-radius: 999px;
      background: rgba(15, 23, 42, 0.6);
      border: 1px solid rgba(125, 211, 252, 0.16);
      color: #dbeafe;
      font-size: 12px;
      letter-spacing: .08em;
      text-transform: uppercase;
    }
    .brand-dot {
      width: 10px;
      height: 10px;
      border-radius: 999px;
      background: linear-gradient(135deg, var(--accent), #7dd3fc);
      box-shadow: 0 0 0 5px rgba(56, 189, 248, 0.14);
    }
    h1 {
      margin: 0 0 10px;
      font-size: 24px;
      font-weight: 700;
      letter-spacing: .02em;
    }
    .hint {
      margin: 0 0 18px;
      color: var(--muted);
      font-size: 13px;
      line-height: 1.6;
    }
    input[type=password] {
      width: 100%;
      margin: 0 0 14px;
      padding: 13px 14px;
      border-radius: 14px;
      border: 1px solid rgba(148, 163, 184, 0.22);
      background: var(--input);
      color: #f8fafc;
      font-size: 15px;
      outline: none;
      transition: border-color .18s ease, box-shadow .18s ease, transform .18s ease;
    }
    input[type=password]:focus {
      border-color: rgba(56, 189, 248, 0.78);
      box-shadow: 0 0 0 4px rgba(56, 189, 248, 0.14);
      transform: translateY(-1px);
    }
    button {
      width: 100%;
      padding: 12px 14px;
      border: 0;
      border-radius: 14px;
      background: linear-gradient(135deg, var(--accent), var(--accent-2));
      color: #f8fafc;
      font-size: 15px;
      font-weight: 700;
      cursor: pointer;
      box-shadow: 0 16px 34px rgba(37, 99, 235, 0.32);
      transition: transform .18s ease, box-shadow .18s ease, filter .18s ease;
    }
    button:hover {
      filter: brightness(1.04);
      transform: translateY(-1px);
    }
    button:active {
      transform: translateY(0);
    }
    .err { margin: 0 0 12px; color: var(--danger); font-size: 13px; min-height: 18px; }
    .footer {
      margin-top: 14px;
      color: rgba(159, 179, 204, .76);
      font-size: 11px;
      text-align: center;
      letter-spacing: .04em;
    }
    @keyframes pinCardIn {
      from { opacity: 0; transform: translateY(12px) scale(.97); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }
  </style>
</head>
<body>
    <form class="card" id="pinForm" autocomplete="off">
    <div class="brand"><span class="brand-dot"></span><span>${TITLE:-Selkies}</span></div>
    <h1>输入 PIN 码以校验权限</h1>
    <p class="err" id="err"></p>
    <input type="password" id="pin" placeholder="请输入 PIN" required autofocus>
    <button type="submit">校验 PIN 码</button>
    <div class="footer">Power by RedialC</div>
  </form>
  <script>
    const pinForm = document.getElementById("pinForm");
    const pinInput = document.getElementById("pin");
    const errEl = document.getElementById("err");
    const pinApi = "${PW_PREFIX}auth/pin";
    pinForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      errEl.textContent = "";
      const pin = pinInput.value || "";
      if (!pin) {
        errEl.textContent = "PIN 不能为空";
        return;
      }
      try {
        const resp = await fetch(pinApi, {
          method: "POST",
          headers: { "X-PIN": pin, "X-Requested-With": "XMLHttpRequest" },
          credentials: "same-origin"
        });
        if (!resp.ok) {
          errEl.textContent = "PIN 不正确，请重试";
          pinInput.focus();
          pinInput.select();
          return;
        }
        const pageResp = await fetch(window.location.href, {
          credentials: "same-origin",
          cache: "no-store",
          headers: {
            "Accept": "text/html",
            "X-Requested-With": "XMLHttpRequest"
          }
        });
        if (!pageResp.ok) {
          errEl.textContent = "PIN 已通过，但页面加载失败，请重新输入";
          return;
        }
        const html = await pageResp.text();
        document.open();
        document.write(html);
        document.close();
      } catch (_) {
        errEl.textContent = "网络异常，请稍后重试";
      }
    });
  </script>
</body>
</html>
EOF

# set dashboard and icon
rm -Rf \
  /usr/share/selkies/web
cp -a \
  /usr/share/selkies/"$DASHBOARD" \
  /usr/share/selkies/web
sed -i "s|REPLACE_DOWNLOADS_PATH|$FILE_MANAGER_PATH|g" /usr/share/selkies/web/nginx/footer.html
cp \
  /usr/share/selkies/www/icon.png \
  /usr/share/selkies/web/favicon.ico
cp \
  /usr/share/selkies/www/icon.png \
  /usr/share/selkies/web/icon.png
cp \
  /usr/share/icons/hicolor/512x512/apps/qq.png \
  /usr/share/selkies/web/qq-icon.png
cp \
  /usr/share/icons/hicolor/128x128/apps/wechat.png \
  /usr/share/selkies/web/wechat-icon.png
# manifest creation
echo "{
  \"name\": \"${TITLE}\",
  \"short_name\": \"${TITLE}\",
  \"manifest_version\": 2,
  \"version\": \"1.0.0\",
  \"display\": \"fullscreen\",
  \"background_color\": \"#000000\",
  \"theme_color\": \"#000000\",
  \"icons\": [
    {
      \"src\": \"icon.png\",
      \"type\": \"image/png\",
      \"sizes\": \"180x180\"
    }
  ],
  \"start_url\": \"/\"
}" > /usr/share/selkies/web/manifest.json
