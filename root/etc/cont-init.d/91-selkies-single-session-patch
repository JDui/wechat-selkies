#!/usr/bin/with-contenv bash
set -e

python3 - <<'PY'
import pathlib
import re
import selkies

selkies_path = pathlib.Path(selkies.__file__).resolve().parent / "selkies.py"
text = selkies_path.read_text(encoding="utf-8")

if "PIN-session takeover" in text:
    print("[selkies-patch] PIN-session takeover already patched")
    raise SystemExit(0)

pattern = re.compile(
    r"(raddr = websocket\.remote_address\s*\n"
    r"\s*self\._set_client_awake_state\(websocket, False\)\s*\n"
    r"\s*data_logger\.info\(f\"Data WebSocket connected from \{raddr\}\"\)\s*\n)"
    r"\s*self\.clients\.add\(websocket\)\s*\n"
    r"\s*self\.data_ws = \(\s*\n\s*websocket\s*\n\s*\)",
    re.MULTILINE,
)

replacement = r"""\1        # PIN-session takeover
        session_cookie_name = os.environ.get("SELKIES_SESSION_COOKIE_NAME", "selkies_session")
        session_state_path = os.environ.get("SELKIES_SESSION_STATE_PATH", "/run/selkies-active-session.json")

        def _header_value(headers, name):
            try:
                return headers.get(name, "")
            except Exception:
                return ""

        request_headers = getattr(websocket, "request_headers", None)
        if request_headers is None:
            request_obj = getattr(websocket, "request", None)
            request_headers = getattr(request_obj, "headers", None)

        cookie_header = _header_value(request_headers, "Cookie")
        cookie_token = ""
        for cookie_part in str(cookie_header or "").split(";"):
            if "=" not in cookie_part:
                continue
            cookie_key, cookie_value = cookie_part.strip().split("=", 1)
            if cookie_key == session_cookie_name:
                cookie_token = cookie_value
                break

        token_hash = ""
        if cookie_token:
            import hashlib

            token_hash = hashlib.sha256(cookie_token.encode("utf-8")).hexdigest()

        active_token_hash = ""
        active_session_id = ""
        active_session_epoch = 0
        try:
            with open(session_state_path, "r", encoding="utf-8") as session_file:
                session_state = json.load(session_file)
            active_token_hash = str(session_state.get("token_hash") or "")
            active_session_id = str(session_state.get("session_id") or "")
            active_session_epoch = int(session_state.get("session_epoch") or 0)
        except Exception:
            pass

        session_enabled = bool(os.environ.get("PASSWORD", ""))
        ws_identified = (not session_enabled) or (
            bool(token_hash)
            and bool(active_token_hash)
            and token_hash == active_token_hash
        )

        if not ws_identified:
            data_logger.info(f"Rejecting stale session websocket from {raddr}")
            try:
                await websocket.send("FORCE_PIN_LOGIN")
            except Exception:
                pass
            try:
                await websocket.close(code=4003, reason="Stale session epoch")
            except Exception:
                pass
            return

        if not hasattr(self, "_session_meta"):
            self._session_meta = {}

        for known_ws in list(self._session_meta.keys()):
            if known_ws not in self.clients:
                self._session_meta.pop(known_ws, None)

        existing_clients = [ws for ws in list(self.clients) if ws is not websocket]
        if existing_clients:
            data_logger.info(
                f"PIN-session takeover: disconnecting {len(existing_clients)} existing client(s) before accepting {raddr}"
            )
            for stale_ws in existing_clients:
                stale_meta = self._session_meta.get(stale_ws) or {}
                same_session_refresh = (
                    bool(token_hash)
                    and stale_meta.get("token_hash", "") == token_hash
                )
                if same_session_refresh:
                    try:
                        await stale_ws.close(code=4004, reason="Session transport refresh")
                    except Exception:
                        pass
                else:
                    try:
                        await stale_ws.send("FORCE_PIN_LOGIN")
                    except Exception:
                        pass
                    try:
                        await stale_ws.close(code=4002, reason="Replaced by a new PIN session")
                    except Exception:
                        pass
                self._session_meta.pop(stale_ws, None)
                self.clients.discard(stale_ws)
                client_permissions.pop(stale_ws, None)

        self.clients.add(websocket)
        self._session_meta[websocket] = {
            "token_hash": token_hash,
            "session_id": active_session_id,
            "session_epoch": active_session_epoch,
        }
        self.data_ws = (
            websocket
        )"""

patched, count = pattern.subn(replacement, text, count=1)
if count != 1:
    print("[selkies-patch] warning: ws_handler patch target not found; skipping PIN-session patch")
    raise SystemExit(0)

cleanup_pattern = "            client_permissions.pop(websocket, None)\n            self.awake_client_states.pop(id(websocket), None)"
cleanup_replacement = (
    "            client_permissions.pop(websocket, None)\n"
    "            if hasattr(self, \"_session_meta\"):\n"
    "                self._session_meta.pop(websocket, None)\n"
    "            self.awake_client_states.pop(id(websocket), None)"
)
if cleanup_pattern in patched:
    patched = patched.replace(cleanup_pattern, cleanup_replacement, 1)

selkies_path.write_text(patched, encoding="utf-8")
print("[selkies-patch] patched PIN-session takeover into ws_handler")
PY
