[global]
    monitor = 0
    follow = mouse
    width = 360
    height = 136
    origin = top-right
    offset = 18x18
    notification_limit = 8
    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 0
    progress_bar_corner_radius = 8
    indicate_hidden = yes
    transparency = 0
    separator_height = 2
    padding = 16
    horizontal_padding = 16
    text_icon_padding = 14
    frame_width = 1
    frame_color = "#334155"
    separator_color = frame
    sort = yes
    idle_threshold = 120
    font = Noto Sans CJK SC 10
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    ellipsize = middle
    word_wrap = yes
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes
    icon_position = left
    min_icon_size = 28
    max_icon_size = 52
    corner_radius = 14
    mouse_left_click = do_action, close_current
    mouse_middle_click = close_current
    mouse_right_click = close_current

[experimental]
    per_monitor_dpi = false

[urgency_low]
    timeout = 6
    background = "#0f172a"
    foreground = "#e2e8f0"
    highlight = "#38bdf8"

[urgency_normal]
    timeout = 8
    background = "#0f172a"
    foreground = "#e2e8f0"
    highlight = "#3b82f6"

[urgency_critical]
    timeout = 0
    background = "#1e293b"
    foreground = "#f8fafc"
    frame_color = "#ef4444"
    highlight = "#ef4444"

[appname="QQ"]
    background = "#0f172a"
    foreground = "#e2e8f0"
    frame_color = "#334155"
    highlight = "#3b82f6"
    timeout = 8

[appname="WeChat"]
    background = "#0f172a"
    foreground = "#e2e8f0"
    frame_color = "#334155"
    highlight = "#22c55e"
    timeout = 8

[appname="wechat"]
    background = "#0f172a"
    foreground = "#e2e8f0"
    frame_color = "#334155"
    highlight = "#22c55e"
    timeout = 8
